# 应用配置
APP_NAME=MiniCodeAI
DEBUG=True
# 请使用随机生成的长字符串（可用 python -c "import secrets; print(secrets.token_urlsafe(64))"）
SECRET_KEY=please-generate-your-own-secret-key

# 数据库配置 (MySQL)
DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/minicodeai

# Redis配置
REDIS_URL=redis://localhost:6379/0

# Chroma向量库配置
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=documents

# DeepSeek API配置
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# VLM模型配置（用于图片理解）
QWEN_VL_API_KEY=your-vlm-api-key-here
QWEN_VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 网络搜索API
TAVILY_API_KEY=your-tavily-api-key-here

# 文件上传配置
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# JWT配置
JWT_SECRET_KEY=please-generate-your-own-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
